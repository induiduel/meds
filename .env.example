# MedSoru ortam değişkenleri — ÖRNEK (gerçek değerleri .env içine yazın; .env git'e girmez)
# Sırları asla istemciye (VITE_*) koymayın.

# --- Yazma parolası (site veri gönderirken X-API-Password) ---
MEDSORU_API_PASSWORD=change-this-before-public-deployment

# --- AI sağlayıcı anahtarları (yalnız SUNUCU tarafı) ---
# Gemini ücretsiz anahtar havuzu (kod GEMINI_FREE_KEY_N hepsini okur)
GEMINI_API_KEY=
GEMINI_FREE_KEY_3=
# GEMINI_FREE_KEY_4, _5, … istenildiği kadar eklenebilir
# Groq yedek (gpt-oss-120b / qwen)
GROQ_API_KEY=
GROQ_API_KEY_2=
# OpenRouter / Muse Spark (ücretsiz katman)
OPENROUTER_API_KEY=
MUSE_SPARK_API_KEY=
MUSE_SPARK_BASE_URL=https://openrouter.ai/api/v1
# OpenCode Zen (ücretsiz Muse Spark)
OPENCODE_API_KEY=
# Yalnız ücretsiz modeller (0 = faturalıya izin ver)
MEDS_FREE_ONLY=1

# --- Supabase (yerel Docker birincil; bulut yedek) ---
SUPABASE_URL=http://localhost:8000
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
CLOUD_SUPABASE_URL=
CLOUD_SUPABASE_PUBLISHABLE_KEY=
CLOUD_SUPABASE_SECRET_KEY=

# --- Yerel klasörler (PROJE_TANITIMI.md boru hattı) ---
MEDS_PROJECT_ROOT=/home/indu/medsor
MEDS_DATABASE_DIR=/home/indu/medsor/meds_database
MEDS_TEMP_DIR=/home/indu/medsor/meds_temp
MEDS_DOWNLOADS_DIR=/home/indu/medsor/meds_downloads
MEDS_CORE_DIR=/home/indu/medsor/meds_database_core
MEDS_DEEPSEEK_DIR=
MEDS_TRANSCRIPTIONS_DIR=

# --- Ollama (yerel LLM; v2 GPU kullanmaz) ---
OLLAMA_URL=http://localhost:11434
MEDS_LLM_BACKEND=cloud

# --- Google Drive servis hesabı (repo dışında tutun) ---
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- HuggingFace (model yükleme/indirme) ---
HF_TOKEN=
HF_TOKEN_MEDS2=
HF_TOKEN_MEDS3_WRITE=

# --- Site / e-posta ---
APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
