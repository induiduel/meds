# AI provider keys. Read ONLY by the backend (server.ts, scripts/).
# Never put these in client code or VITE_* variables: anything in the browser bundle is public.

# Gemini key pool: free keys are tried first, the billed key is the last resort.
GEMINI_API_KEY="MY_GEMINI_FREE_KEY_1"
GEMINI_FREE_KEY_2="MY_GEMINI_FREE_KEY_2"
GEMINI_BILLED_KEY="MY_GEMINI_BILLED_KEY"

# Groq Cloud fallback (gpt-oss-120b / qwen / llama)
GROQ_API_KEY="MY_GROQ_API_KEY"
GROQ_API_KEY_2="MY_GROQ_API_KEY_2"

# Supabase (server uses the secret key; publishable key is public by design)
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
SUPABASE_PUBLISHABLE_KEY=""

# Optional local folders (leave empty to disable the related watcher/ingestion)
MEDS_DATABASE_DIR=""          # desktop folder scanned for lecture PDFs/PPTX
MEDS_DEEPSEEK_DIR=""          # raw DeepSeek exports to ingest
MEDS_TRANSCRIPTIONS_DIR=""    # lecture audio transcripts

# Optional SMTP for welcome emails
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# Muse Spark 1.3 Free (Son Çare / Tüm AI'lar Limit Doldurduğunda Otomatik Kurtarma Modeli)
MUSE_SPARK_API_KEY=""
MUSE_SPARK_BASE_URL="https://opencode.ai/zen/v1"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
