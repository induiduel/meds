# Caddyfile — meds-server kapısı (cloudflared → meds-server:3000 → meds-app:3000).
# Amaç: dağıtımda meds-app yeniden başlarken ziyaretçi 502 görmesin; bağlantı kurulamayan
# istekler 60 sn'ye kadar bekletilip yeni süreç dinlemeye başlayınca ona aktarılır
# (Cloudflare kaynak zaman aşımı 100 sn). Yanıt akışı (SSE/WebSocket) olduğu gibi geçer.
{
	admin off
	auto_https off
	log default {
		level WARN
	}
}

:3000 {
	# Supabase 2026-10-12'de kaldırıldı. Eski sürümü önbellekte kalan tarayıcıların doğrudan veritabanı
	# çağrıları hızlıca reddedilir (uygulama zaten sunucu API'sine düşer; yeni sürüm yüklenince biter).
	@supabase_eski path /realtime/v1/* /rest/v1/* /auth/v1/* /storage/v1/*
	respond @supabase_eski 410

	# Ana uygulama (Express API + Vite SPA)
	reverse_proxy meds-app:3000 {
		lb_try_duration 60s
		lb_try_interval 250ms
		transport http {
			dial_timeout 2s
		}
	}
}

