# Dockerfile.embed — bge-m3 sorgu vektörleme servisi (CPU, Oracle ARM).
# Cihazdaki :8094 servisinin aynısı (scripts/agents/embed_server.py, MEDS_EMBED_MODEL=BAAI/bge-m3).
# Model (~1.2GB) ilk açılışta HF_HOME volume'üne iner, sonra kalıcıdır.
FROM python:3.11-slim

RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
  && pip install --no-cache-dir sentence-transformers

WORKDIR /app
COPY scripts/agents/embed_server.py /app/embed_server.py

ENV MEDS_EMBED_MODEL=BAAI/bge-m3 \
  MEDS_EMBED_HOST=0.0.0.0 \
  MEDS_EMBED_PORT=8094 \
  HF_HOME=/models \
  OMP_NUM_THREADS=4

EXPOSE 8094

CMD ["python3", "/app/embed_server.py"]
