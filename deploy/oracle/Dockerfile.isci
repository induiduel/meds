# Dockerfile.isci — Ders işçisi (Oracle, 7/24): Drive izleme + yeni ders PDF'ini Claude Code (abonelik) ile işleme.
# Yerel GPU YOK: OCR Tesseract (CPU), vektör meds-embed konteynerinden, LLM işi Claude aboneliğinden (CLAUDE_CODE_OAUTH_TOKEN).
# Çıktılar yalnız /isci/taslak altına yazılır; canlı veriye yazmaz (yayın yönetim onayıyla).
FROM node:24-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip tesseract-ocr tesseract-ocr-tur tesseract-ocr-eng git ca-certificates tzdata \
  && pip3 install --no-cache-dir --break-system-packages pymupdf faster-whisper python-docx \
  && npm install -g --no-audit --no-fund @anthropic-ai/claude-code \
  && rm -rf /var/lib/apt/lists/* /root/.npm

ENV TZ=Europe/Istanbul \
    PYTHONUNBUFFERED=1 \
    DISABLE_AUTOUPDATER=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# Uygulama kodu salt-okunur bağlanır (/app = meds/); durum /isci (yalnız Oracle).
WORKDIR /app
USER node
CMD ["python3", "/app/scripts/ders_isci/izle.py"]
