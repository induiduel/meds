# Dockerfile.oracle — Oracle Always Free (ARM Ampere dahil) üzerinde MedSoru API sunucusu.
# Yalnızca web/API katmanı çalışır (server.ts, port 3000). Ağır AI boru hattı Oracle'da çalışmaz.
# 2026-10-20: imaj yalnız çalışma ortamı + bağımlılıklar (/node_modules). Kod ve dist/ imaja gömülmez;
# compose ../..:/app bağlar, dist/ cihazda derlenip rsync ile gelir. İmaj yalnız package*.json ya da bu dosya
# değişince yeniden kurulur (deploy-code.sh kendisi karar verir).
# Node ESM çözümü /app'ten yukarı çıkarak /node_modules'u bulur; process.cwd() yolları için MEDS_NODE_MODULES.
FROM node:24-bookworm-slim

# Chromium: PDF Stüdyosu, soru dışa aktarımı ve ek modül föyü `/api/pdf/render` ile başsız tarayıcıda basılır.
# 2026-11-13: imajda Chrome yoktu → canlıda `pdf/status` "available:false", üstelik uç yazma parolası istiyordu (H556).
# Tarayıcı + Türkçe glifler için DejaVu yazı tipleri; Chrome kendi kum havuzuyla çalışır (konteyner root olsa da
# chromium paketi `--no-sandbox` olmadan açılır; pdfRenderService root'ta `--no-sandbox` ekler).
# H576 kök neden: PDF düzeni istemci tarayıcısının yazı tipiyle (Olcer ölçümü, çoğu kullanıcıda Times New Roman)
# sayfalanır, ama PDF bu konteynerin Chromium'uyla basılır. Konteynerde yalnız DejaVu Serif olunca
# `'Times New Roman','Liberation Serif',Times,'DejaVu Serif',serif` yığını DejaVu'ya düşüyordu; DejaVu Times'tan
# geniş/uzun olduğundan içerik ölçülenden fazla yer kaplayıp gövdeden taşıyor, alt bilgi hizasında kesiliyordu.
# fonts-liberation (Serif/Sans/Mono) Times New Roman/Arial/Courier New ile METRİK UYUMLUDUR; yığın artık Liberation'a
# düşer ve basım ölçümle aynı yüksekliği verir. fonts-dejavu-core latin dışı/yedek kapsama için kalır.
RUN apt-get update && apt-get install -y --no-install-recommends python3 chromium fonts-dejavu-core fonts-liberation \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /
COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

ENV MEDS_NODE_MODULES=/node_modules
ENV PATH=/node_modules/.bin:$PATH
WORKDIR /app

EXPOSE 3000

CMD ["tsx", "server.ts"]
