# Dockerfile.oracle — Oracle Always Free (ARM Ampere dahil) üzerinde MedSoru API sunucusu.
# Yalnızca web/API katmanı çalışır (server.ts, port 3000). Ağır AI boru hattı Oracle'da çalışmaz.
# 2026-10-20: imaj yalnız çalışma ortamı + bağımlılıklar (/node_modules). Kod ve dist/ imaja gömülmez;
# compose ../..:/app bağlar, dist/ cihazda derlenip rsync ile gelir. İmaj yalnız package*.json ya da bu dosya
# değişince yeniden kurulur (deploy-code.sh kendisi karar verir).
# Node ESM çözümü /app'ten yukarı çıkarak /node_modules'u bulur; process.cwd() yolları için MEDS_NODE_MODULES.
FROM node:24-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends python3 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /
COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

ENV MEDS_NODE_MODULES=/node_modules
ENV PATH=/node_modules/.bin:$PATH
WORKDIR /app

EXPOSE 3000

CMD ["tsx", "server.ts"]
