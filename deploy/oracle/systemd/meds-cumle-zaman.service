[Unit]
Description=MeDSor sesli ders cümle zamanlaması (yeni/değişen ses ve metin; yoksa ~2 sn) — scripts/sesli_anlatim/cumle_zaman.py
After=docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/medsor/meds
Environment=CUDA_VISIBLE_DEVICES= PYTHONUNBUFFERED=1 TZ=Europe/Istanbul MEDS_API=http://127.0.0.1:3000
# Sanal ortam: python3 -m venv ~/medsor/venv-cumle && venv-cumle/bin/pip install numpy imageio-ffmpeg (ARM ffmpeg dahil)
ExecStart=/bin/sh -c 'mkdir -p deploy/oracle/logs && /home/ubuntu/medsor/venv-cumle/bin/python scripts/sesli_anlatim/cumle_zaman.py --hepsi 2>&1 | grep -v ": güncel$" >> deploy/oracle/logs/cumle-zaman.log; exit 0'
Nice=15
IOSchedulingClass=idle
MemoryMax=1G
CPUQuota=100%
OOMScoreAdjust=500
TimeoutStartSec=30min
