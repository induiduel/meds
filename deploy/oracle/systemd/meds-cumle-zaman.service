[Unit]
Description=MeDSor sesli ders cümle zamanlaması + PDF kelime işareti (yeni/değişen ses ve metin; yoksa ~2 sn) — scripts/sesli_anlatim/cumle_zaman.py, pdf_isaret.py
After=docker.service

[Service]
Type=oneshot
User=ubuntu
# Türev klasörler kapsayıcı (root) ve cihazdan sudo rsync (opc) tarafından da yazılıyor; ubuntu yazamayınca her ders
# "Permission denied" alıp sessizce atlanıyordu (2026-10-20, 15 ders cümle zamanısız). "+" = root olarak, her çalıştırmada onar.
ExecStartPre=+/bin/sh -c 'cd /home/ubuntu/medsor/meds/data/sesli_anlatim && mkdir -p cumle_zaman kelime_zaman isaret && chown -R ubuntu:ubuntu cumle_zaman kelime_zaman isaret'
WorkingDirectory=/home/ubuntu/medsor/meds
Environment=CUDA_VISIBLE_DEVICES= PYTHONUNBUFFERED=1 TZ=Europe/Istanbul MEDS_API=http://127.0.0.1:3000
# Sanal ortam: python3 -m venv ~/medsor/venv-cumle && venv-cumle/bin/pip install numpy imageio-ffmpeg pymupdf (ARM ffmpeg dahil)
ExecStart=/bin/sh -c 'mkdir -p deploy/oracle/logs && /home/ubuntu/medsor/venv-cumle/bin/python scripts/sesli_anlatim/cumle_zaman.py --hepsi 2>&1 | grep -v ": güncel$" >> deploy/oracle/logs/cumle-zaman.log; exit 0'
# Okunan cümlenin slayttaki madde/kelime/resim kutuları (canlı ders kelime kelime işaret); değişmeyen ders atlanır.
# PDF yerelde yoksa sunucunun /api/lecture-pdf ucundan data/sesli_anlatim/.pdf_onbellek'e iner.
ExecStart=/bin/sh -c '/home/ubuntu/medsor/venv-cumle/bin/python scripts/sesli_anlatim/pdf_isaret.py --hepsi 2>&1 | grep -v "pymupdf_layout" >> deploy/oracle/logs/pdf-isaret.log; exit 0'
Nice=15
IOSchedulingClass=idle
MemoryMax=1G
CPUQuota=100%
OOMScoreAdjust=500
TimeoutStartSec=30min
