# /etc/systemd/system/meds-ders-yayin.service — onaylanan ders taslaklarını yayınlar (scripts/ders_isci/yayinla.py --sunucu)
# Kurulum: sudo cp deploy/oracle/systemd/meds-ders-yayin.* /etc/systemd/system/ && sudo systemctl daemon-reload
#          && sudo systemctl enable --now meds-ders-yayin.timer
[Unit]
Description=MedSoru ders işçisi yayını (onaylı taslak → site; yoksa ~0 sn)
After=docker.service
[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/medsor/meds
Environment=CUDA_VISIBLE_DEVICES= PYTHONUNBUFFERED=1 TZ=Europe/Istanbul MEDS_PROJECT_ROOT=/home/ubuntu/medsor
ExecStart=/bin/sh -c 'mkdir -p deploy/oracle/logs && /usr/bin/python3 scripts/ders_isci/yayinla.py --sunucu >> deploy/oracle/logs/ders-yayin.log 2>&1'
Nice=10
MemoryMax=2G
CPUQuota=150%
TimeoutStartSec=40min
