rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'nofrostlife@gmail.com';
    }

    // Committees collection: read-only for public, write for admin
    match /committees/{committeeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Lecture notes & slides collection: read-only for public, write for admin
    match /lecture_notes/{noteId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Past questions collection: read-only for public, write for admin
    match /past_questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Past question reports collection: public submit, admin manage
    match /past_question_reports/{reportId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Past question comments collection: public submit, admin manage
    match /past_question_comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Questions collection:
    // Students can read, create, and update (add fragments/options),
    // and authorized users/admins can delete questions and draft consolidations
    match /questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // System status collection: read-only for public, admin write
    match /system_status/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admin commands collection: admin only
    match /admin_commands/{commandId} {
      allow read, write: if isAdmin();
    }

    // Admin notifications collection: admin only
    match /admin_notifications/{notifId} {
      allow read, write: if isAdmin();
    }

    // User profiles collection: public read, write for owner or admin
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
  }
}
