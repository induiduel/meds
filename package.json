{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "python3 scripts/surum_gunlugu.py; vite build",
    "surum:gunluk": "python3 scripts/surum_gunlugu.py",
    "postbuild": "node scripts/prune-dist.mjs --keep-hours 6 --apply",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "check:online": "tsx scripts/check-online-status.ts",
    "check:status": "tsx scripts/check-online-status.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "verify:answers": "node scripts/verify-question-answers.mjs --unverified",
    "verify:watch": "node scripts/verify-question-answers.mjs --watch",
    "verify:all": "node scripts/verify-question-answers.mjs --all",
    "slides:audit": "node scripts/audit-and-disconnect-faulty-slides.mjs",
    "slides:match": "node scripts/match-and-link-lecture-slides.mjs",
    "slides:sync": "node scripts/manage-slide-relations.mjs --all",
    "slides:stats": "node scripts/manage-slide-relations.mjs --stats",
    "check:updates": "node scripts/detect-database-updates.mjs",
    "sync:updates": "node scripts/detect-database-updates.mjs --sync",
    "transcribe:audio": "node scripts/transcribe-drive-audio.mjs",
    "transcribe:watch": "node scripts/transcribe-drive-audio.mjs --watch",
    "rag:index": "node scripts/index-rag-knowledge.mjs",
    "rag:index:all": "node scripts/index-rag-knowledge.mjs --limit 10000",
    "decks:build": "python scripts/build_learning_decks.py",
    "decks:packages": "python3 scripts/build_deck_packages.py",
    "sync:deepseek": "python scripts/sync_deepseek_data.py",
    "sync:drive": "node scripts/orchestrate_drive_curriculum_ai.mjs",
    "sync:drive:dry": "node scripts/orchestrate_drive_curriculum_ai.mjs --dry-run",
    "glossary:build": "python scripts/generate_medical_glossary.py",
    "git:sync": "node scripts/auto-git-sync.mjs --once",
    "git:watch": "node scripts/auto-git-sync.mjs --interval=20",
    "eval:recall": "tsx scripts/eval/recall-engine.mts",
    "eval:recall:realtime": "tsx scripts/eval/recall-realtime.mts --split all",
    "eval:pool": "tsx scripts/eval/pool-cluster-check.mts",
    "eval:pool:scale": "tsx scripts/eval/pool-cluster-scale.mts",
    "eval:intake": "tsx scripts/eval/question-intake-unit.mts",
    "eval:all": "tsx scripts/eval/question-intake-unit.mts && tsx scripts/eval/pool-cluster-synthetic.mts && tsx scripts/eval/pool-cluster-check.mts && tsx scripts/eval/recall-engine.mts",
    "composer:model": "python3 scripts/composer/build_composer_model.py",
    "composer:sim": "tsx scripts/composer/simulate.mts"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.15",
    "@vitejs/plugin-react": "^6.1.1",
    "compression": "^1.8.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "lottie-web": "^5.12.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "mediabunny": "^1.62.0",
    "motion": "^12.23.24",
    "msedge-tts": "^2.1.0",
    "nodemailer": "^10.0.11",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.13.0",
    "tesseract.js": "^7.0.0",
    "vite": "^8.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
